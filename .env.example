# Runtime connection: use a pooled URL in production; keep SSL enabled remotely.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proxy_ledger
# Migration connection: use a direct URL when the runtime URL uses a pooler.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proxy_ledger

# Auth.js: generate a cryptographically random secret of at least 32 characters.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL is inferred by Auth.js v5; set only when your deployment needs a canonical URL.
# AUTH_URL=https://your-domain.example
# For a trusted reverse proxy on self-hosted deployments only; Vercel infers this.
# AUTH_TRUST_HOST=true
