    "@prisma/client": "7.10.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.2.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.16.3",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
