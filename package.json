    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.0",
    "playwright": "1.64.0",
    "postcss": "^8.5.29",
    "prisma": "7.10.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
