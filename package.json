{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-prisma.mjs && next build",
